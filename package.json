{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand",
    "start": "nodemon",
    "start:debug": "nodemon --inspect --exec ts-node src/app.ts",
    "worker:waitlist": "nodemon --watch src --ext ts --exec ts-node src/workers/waitlistWorker.ts",
    "worker:waitlist:prod": "node dist/workers/waitlistWorker.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start:prod": "node dist/app.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/config/data-source.js migration:run"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express-rate-limit": "^8.7.0",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "pg": "^8.15.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.23"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^30.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
